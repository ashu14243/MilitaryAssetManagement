# Local development only. Set production values in the Render dashboard.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/military_assets
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
# Render sets PORT automatically; this is for local development.
PORT=4000
CORS_ORIGIN=http://localhost:5173
# Use true for Render Postgres; false for local PostgreSQL.
DATABASE_SSL=false
